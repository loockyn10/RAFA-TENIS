# Valores públicos para la conexión del cliente con Supabase.
# No agregar secretos ni service_role en variables expuestas al navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Clave PÚBLICA VAPID para los avisos push (Sprint 15). Es seguro que viaje al navegador; la clave PRIVADA nunca va acá:
# se guarda como secreto de la Edge Function dispatch-push (ver docs/CURRENT_STATE.md, «Sprint 15»). Vacía = push no configurado.
VITE_VAPID_PUBLIC_KEY=
